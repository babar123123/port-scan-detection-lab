# Network Scan
alert tcp any any -> any any (flags:S; msg:"LOCAL Network Scan - TCP SYN Detected"; sid:1000001; rev:1;)

# TCP ACK-only packet
alert tcp any any -> 192.168.56.107 any (flags:A; msg:"LOCAL TCP ACK-only Packet Detected"; sid:1000002; rev:1;)

# TCP FIN scan pattern
alert tcp any any -> 192.168.56.107 any (flags:F; msg:"LOCAL TCP FIN Packet Detected"; sid:1000003; rev:1;)

# TCP NULL scan pattern
alert tcp any any -> 192.168.56.107 any (flags:0; msg:"LOCAL TCP NULL Packet Detected"; sid:1000004; rev:1;)

# TCP Xmas scan pattern
alert tcp any any -> 192.168.56.107 any (flags:FPU; msg:"LOCAL TCP Xmas Packet Detected"; sid:1000005; rev:1;)

# UDP packets
alert udp any any -> 192.168.56.107 any (msg:"LOCAL UDP Packet Probe Detected"; sid:1000006; rev:1;)

# SSH repeated connection attempts (not proof of brute force)
alert tcp any any -> any 22 (flags:S; msg:"LOCAL Possible SSH Brute Force"; sid:1000016; rev:1;)
